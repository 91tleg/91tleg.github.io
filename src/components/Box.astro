---
interface Props {
  title: string;
  id?: string;
  isNew?: boolean;
  backToTop?: boolean;
}

const { title, id, isNew = false, backToTop = true } = Astro.props;
---

<section class="box" id={id}>
  <h2>{title}{isNew && <span class="new"> NEW!</span>}</h2>
  <slot />
  {backToTop && <a class="top" href="#top">&uarr; back to top</a>}
</section>

<style>
  .box {
    border: 3px double var(--green);
    background: var(--panel);
    padding: 12px 16px 16px;
    margin-bottom: 16px;
  }
  h2 {
    color: var(--yellow);
    font-size: 1.45rem;
    margin-bottom: 6px;
    text-decoration: underline wavy var(--magenta);
    text-underline-offset: 4px;
  }
  .top {
    display: block;
    margin-top: 10px;
    text-align: right;
    font-size: 0.9rem;
  }
  .new {
    color: var(--yellow);
    text-decoration: none;
    display: inline-block;
    animation: blink 1s steps(1) infinite;
  }
</style>
