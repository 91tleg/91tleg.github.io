---
import { Image } from 'astro:assets';
import type { Tech } from '../data/tech';

type Props = Tech;

const { name, icon, svgPath, color } = Astro.props;
---

<li class="btn" style={`--bg: ${color}`}>
  {icon && <Image src={icon} alt="" width={22} height={22} class="logo" />}
  {
    svgPath && (
      <svg class="logo" viewBox="0 0 24 24" aria-hidden="true">
        <path d={svgPath} fill="currentColor" />
      </svg>
    )
  }
  <span>{name}</span>
</li>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 88px;
    height: 31px;
    padding: 0 8px;
    background: var(--bg);
    border: 1px solid #000;
    box-shadow: inset 1px 1px rgba(255, 255, 255, 0.45), inset -1px -1px rgba(0, 0, 0, 0.45);
    font: 700 12px/1 Arial, sans-serif;
    color: #fff;
    list-style: none;
  }
  .logo {
    width: 22px;
    height: 22px;
    object-fit: contain;
    flex: none;
  }
</style>
