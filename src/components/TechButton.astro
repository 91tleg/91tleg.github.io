---
import { Image } from 'astro:assets';
import type { Tech } from '../data/tech';

type Props = Tech;

const { name, icon, svgPath, color, cutOff } = Astro.props;
const LOGO_SIZE = 22;
const logoWidth = icon && !cutOff ? Math.round((LOGO_SIZE * icon.width) / icon.height) : LOGO_SIZE;
---

<li class="btn" style={`--bg: ${color}`}>
  {
    icon && (
      <Image
        src={icon}
        alt=""
        width={logoWidth}
        height={LOGO_SIZE}
        class:list={['logo', { 'cut-off': cutOff }]}
        style={cutOff ? `object-position: ${cutOff}` : undefined}
      />
    )
  }
  {
    svgPath && (
      <svg class="logo" viewBox="0 0 24 24" aria-hidden="true">
        <path d={svgPath} fill="currentColor" />
      </svg>
    )
  }
  <span>{name}</span>
</li>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 88px;
    height: 31px;
    overflow: hidden;
    padding: 0 8px;
    background: var(--bg);
    border: 1px solid #000;
    box-shadow: inset 1px 1px rgba(255, 255, 255, 0.45), inset -1px -1px rgba(0, 0, 0, 0.45);
    font: 700 12px/1 Arial, sans-serif;
    color: #fff;
    list-style: none;
  }
  .logo {
    width: auto;
    max-width: none;
    object-fit: contain;
    flex: none;
  }
  svg.logo {
    width: 22px;
    height: 22px;
  }
  /* Square slot like the other logos; the rest of the logo is cut off. */
  .logo.cut-off {
    width: 22px;
    height: 22px;
    object-fit: cover;
  }
</style>
