---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="marquee" role="note" aria-label={text}>
  <span aria-hidden="true">{text}</span>
</div>

<style>
  .marquee {
    overflow: hidden;
    white-space: nowrap;
    background: var(--magenta);
    color: var(--yellow);
    font-weight: 700;
    border: 3px dotted var(--yellow);
    padding: 2px 0;
  }
  .marquee span {
    display: inline-block;
    padding-left: 100%;
    animation: scroll 18s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee span { padding-left: 0; }
  }
</style>
