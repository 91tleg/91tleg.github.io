---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { name, github, youtube } = project.data;
---

<article class="project">
  <h3>{name}</h3>
  <div class="desc"><Content /></div>
  {
    youtube && (
      <div class="video">
        <iframe
          src={youtube}
          title={`${name} demo video`}
          loading="lazy"
          allow="encrypted-media; picture-in-picture"
          allowfullscreen
        />
      </div>
    )
  }
  <a href={github} target="_blank" rel="noreferrer">View on GitHub &rarr;</a>
</article>

<style>
  .project + .project {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 2px dashed var(--magenta);
  }
  h3 {
    color: var(--cyan);
    font-size: 1.2rem;
    margin-bottom: 4px;
  }
  .desc :global(p) { margin-bottom: 8px; }
  .video {
    aspect-ratio: 16 / 9;
    max-width: 480px;
    margin: 8px 0 10px;
    border: 3px ridge #ccc;
    background: #000;
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  a { font-weight: 700; }
</style>
