---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { name, github, site } = project.data;
---

<article class="project">
  <h3>{name}</h3>
  <div class="desc"><Content /></div>
  <p class="links">
    {site && <a href={site} target="_blank" rel="noreferrer">Visit site &rarr;</a>}
    {github && <a href={github} target="_blank" rel="noreferrer">View on GitHub &rarr;</a>}
  </p>
</article>

<style>
  .project + .project {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 2px dashed var(--magenta);
  }
  h3 {
    color: var(--cyan);
    font-size: 1.2rem;
    margin-bottom: 4px;
  }
  .desc :global(p) { margin-bottom: 8px; }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-weight: 700;
  }
</style>
